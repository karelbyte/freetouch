<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- El toolset WDK vive en el árbol local; MSBuild lo encuentra vía
       AdditionalVCTargetsPath sin tocar Program Files. -->
  <PropertyGroup>
    <AdditionalVCTargetsPath>D:\project\freetouch\third_party\msbuild-vc\v170\</AdditionalVCTargetsPath>
    <!-- Fija el SDK/WDK 26100 (el import MSVC lo dejaría en "10.0"). -->
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <!-- La comprobación de configuración no aplica a drivers sueltos. -->
    <SkipInvalidConfigurations>true</SkipInvalidConfigurations>
    <!-- Sin manifest en drivers kernel. -->
    <GenerateManifest>false</GenerateManifest>
  </PropertyGroup>
</Project>
